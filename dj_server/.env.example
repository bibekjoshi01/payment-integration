# No keys needed in mock mode. Use sandbox to call actual provider test APIs.
PAYMENT_MODE=mock
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=local-payment-demo-only-change-before-deployment
FRONTEND_BASE_URL=http://localhost:5173

# PayPal sandbox app (not a live app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Stripe sandbox / test keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack test secret key (sk_test_...)
PAYSTACK_SECRET_KEY=

# Flutterwave v3 test secret key (FLWSECK_TEST-...)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
